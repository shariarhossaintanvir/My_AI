# ==========================================
# MY AI — Environment Configuration Template
# ==========================================
# Copy this file to .env.local for local development.
# Do NOT commit actual secrets or production keys into version control.

# Anthropic Claude API Configuration
# Get your API key at: https://console.anthropic.com/
ANTHROPIC_API_KEY=
# Default Claude model ID to use
# Supported options:
# - claude-sonnet-4-6 (Default recommended: premier reasoning, coding, vision with 1M context)
# - claude-opus-4-6 (Frontier reasoning, deep architecture, multi-step problem solving)
# - claude-haiku-4-5 (Ultra-fast, low-latency, lightweight queries)
ANTHROPIC_MODEL=claude-sonnet-4-6

# Single-Owner Authentication & Access Control
# Set this to the authorized owner email address. Public registration is permanently disabled.
OWNER_EMAIL=owner@example.com

# Supabase PostgreSQL & Auth Configuration
# Required for cloud persistence and sync.
# In local development without Supabase credentials, the app gracefully falls back to IndexedDB local persistence.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Mock AI Mode (Development Only)
# When explicitly set to "true", the app runs using an intelligent development mock streaming provider
# without incurring API costs. In production, mock mode is permanently disabled.
MOCK_AI_MODE=false
USE_MOCK_AI=false

# Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
